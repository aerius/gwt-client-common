<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Explicitly no parent, don't want to drag the whole aerius-root-pom dependencymanagement along when importing this. -->
  <groupId>nl.aerius</groupId>
  <version>1.13.0-SNAPSHOT</version>

  <artifactId>gwt-client-common-bom</artifactId>
  <name>AERIUS :: Common GWT Client BOM</name>

  <packaging>pom</packaging>

  <licenses>
    <license>
      <name>GNU Affero General Public License</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
    </license>
  </licenses>

  <contributors>
    <contributor>
      <organization>Ministerie van Landbouw, Visserij, Voedselzekerheid en Natuur</organization>
      <organizationUrl>https://www.rijksoverheid.nl/ministeries/ministerie-van-landbouw-visserij-voedselzekerheid-en-natuur</organizationUrl>
    </contributor>
    <contributor>
      <organization>UK Government</organization>
      <organizationUrl>https://www.gov.uk</organizationUrl>
    </contributor>
  </contributors>

  <distributionManagement>
    <repository>
      <id>aerius-nexus</id>
      <url>https://nexus.aerius.nl/repository/maven-releases/</url>
    </repository>
    <snapshotRepository>
      <id>aerius-nexus</id>
      <url>https://nexus.aerius.nl/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <gwt.java.version>17</gwt.java.version>
    <gwt-maven-plugin.version>1.3.0</gwt-maven-plugin.version>

    <org.gwtproject.version>2.13.1</org.gwtproject.version>
    <vue.version>1.0.1</vue.version>
    <aerius.vue.version>1.1.0-AERIUS-1</aerius.vue.version>
    <aerius.shared-geo.version>6.0.1-2</aerius.shared-geo.version>

    <elemental2.verion>1.2.3</elemental2.verion>
    <guava.version>33.4.0-jre</guava.version>
    <!-- Keep guice on 6.0.0, 7.0.0 doesn't seem to work with GWT gin -->
    <guice.version>6.0.0</guice.version>
    <gwt.gin.version>2.1.2</gwt.gin.version>
    <gwt.eventbinder.version>1.1.0</gwt.eventbinder.version>
    <gwt-ol3.version>8.5.0</gwt-ol3.version>
  </properties>

  <dependencyManagement>
    <dependencies>
       <!-- Dependencies that are part of this project -->
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-common</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-common-json</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-common-geo</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-geo-ol3</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-vue</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-client-vuelidate</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>gwt-shared-geo-common</artifactId>
        <version>${project.version}</version>
        <type>gwt-lib</type>
      </dependency>

      <!-- Dependencies that this project relies on -->
      <dependency>
        <groupId>nl.aerius</groupId>
        <artifactId>shared-geo</artifactId>
        <version>${aerius.shared-geo.version}</version>
      </dependency>
      <dependency>
        <groupId>org.gwtproject</groupId>
        <artifactId>gwt</artifactId>
        <version>${org.gwtproject.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.inject</groupId>
        <artifactId>guice</artifactId>
        <version>${guice.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.inject.extensions</groupId>
        <artifactId>guice-assistedinject</artifactId>
        <version>${guice.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.gwt.inject</groupId>
        <artifactId>gin</artifactId>
        <version>${gwt.gin.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.gwt.eventbinder</groupId>
        <artifactId>eventbinder</artifactId>
        <version>${gwt.eventbinder.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.elemental2</groupId>
        <artifactId>elemental2-core</artifactId>
        <version>${elemental2.verion}</version>
      </dependency>
      <dependency>
        <groupId>com.google.elemental2</groupId>
        <artifactId>elemental2-dom</artifactId>
        <version>${elemental2.verion}</version>
      </dependency>
      <dependency>
        <groupId>com.axellience</groupId>
        <artifactId>vue-gwt</artifactId>
        <version>${vue.version}</version>
      </dependency>
      <dependency>
        <groupId>com.axellience</groupId>
        <artifactId>vue-gwt-processors</artifactId>
        <version>${aerius.vue.version}</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <groupId>com.github.tdesjardins</groupId>
        <artifactId>gwt-ol3</artifactId>
        <version>${gwt-ol3.version}</version>
        <type>gwt-lib</type>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
